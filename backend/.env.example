# Create a separate Supabase PostgreSQL project; enter credentials locally.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DEMO_MODE=true
MAX_INPUT_CHARS=8000
MAX_CLAIMS=5
MAX_PENDING_JOBS=8
PROVIDER_TIMEOUT_SECONDS=12
# Live mode sends submitted text to these external providers; keep keys backend-only.
BRAVE_SEARCH_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
