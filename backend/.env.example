# Create a separate Supabase PostgreSQL project; enter credentials locally.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DEMO_MODE=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_INPUT_CHARS=8000
MAX_CLAIMS=5
MAX_PENDING_JOBS=8
PROVIDER_TIMEOUT_SECONDS=12
# GitHub policy scan calls Gemini with the submitted claim and selected policy passages.
# Add your Gemini key only to ignored backend/.env; never put it in frontend/.env.
BRAVE_SEARCH_API_KEY=
LLM_PROVIDER=gemini
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# The production entry point is public; no judge login variables are required.
